    public function test_update_keeps_own_{{ field }}(): void
    {
        ${{ variable }} = {{ factory }}::new()->createOne();

        $this->patchJson(route('{{ route }}', ${{ variable }}->getRouteKey()), ['{{ field }}' => ${{ variable }}->getRawOriginal('{{ field }}')])
            ->assertOk();
    }

    public function test_update_rejects_{{ field }}_of_another_{{ singular }}(): void
    {
        $first = {{ factory }}::new()->createOne();
        $second = {{ factory }}::new()->createOne();

        $this->patchJson(route('{{ route }}', $second->getRouteKey()), ['{{ field }}' => $first->getRawOriginal('{{ field }}')])
            ->assertUnprocessable()
            ->assertJsonValidationErrors(['{{ field }}']);
    }
